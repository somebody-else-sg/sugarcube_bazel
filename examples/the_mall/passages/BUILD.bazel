load("@sugarcube_bazel//:defs.bzl", "sugarcube_library")

package(default_visibility=["//:__subpackages__"])

sugarcube_library(
    name="widgets",
    tags=["widget"],
    srcs=[
        "media_coding.tw",
    ],
)

sugarcube_library(
    name="locations",
    srcs=[
        "locations.tw",
    ],
    deps=[
        "//passages/home",
        "//passages/mall",
    ],
)

filegroup(
    name="menu_data",
    srcs=["mall_pic.jpg"],
)

sugarcube_library(
    name="start",
    srcs=[
        "start.tw",
        "stats.tw",
        "story_author.tw",
        "story_caption.tw",
        "story_init.tw",
        "story_menu.tw",
        "story_subtitle.tw",
    ],
    deps=[
        ":widgets",
        ":locations",
    ],
    data=[
        ":menu_data",
    ],
)
